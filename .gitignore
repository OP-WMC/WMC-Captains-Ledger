# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/       # ignore node_modules in any folder

# Build output
dist/
dist-ssr/

# Local environment files
*.local
.env                # ignore .env files at any level
.env.*              # ignore .env.development, .env.production, etc.

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Explicitly ignore frontend and backend env & node_modules if they are in subfolders
frontend/node_modules/
backend/node_modules/
frontend/.env
backend/.env
frontend/.env.*
backend/.env.*
